{
  "version": 1,
  "description": "Canonical event fixtures for Pi Deck base-state/overlay reducer tests. These are contract fixtures until the shared reducer lands; fake RPC can emit equivalent records with --prompt-scenario all.",
  "initialState": {
    "baseState": "idle",
    "overlays": {
      "streaming": false,
      "toolRunning": false,
      "compacting": false,
      "retrying": false,
      "localQueuedStartCount": 0,
      "piQueuedSteeringCount": 0,
      "piQueuedFollowUpCount": 0,
      "needsUserInput": false
    },
    "activeTools": [],
    "pendingExtensionUiQueue": []
  },
  "cases": [
    {
      "id": "agent-start-working",
      "events": [{ "type": "agent_start", "runId": "run_1" }],
      "expect": { "baseState": "working" }
    },
    {
      "id": "message-update-streaming-overlay",
      "events": [
        { "type": "agent_start", "runId": "run_1" },
        {
          "type": "message_update",
          "messageId": "msg_assistant_1",
          "role": "assistant",
          "delta": "Hello",
          "content": "Hello",
          "done": false
        }
      ],
      "expect": {
        "baseState": "working",
        "overlays": { "streaming": true }
      }
    },
    {
      "id": "tool-card-lifecycle",
      "events": [
        {
          "type": "tool_execution_start",
          "toolCallId": "tool_1",
          "name": "bash"
        },
        {
          "type": "tool_execution_update",
          "toolCallId": "tool_1",
          "output": "partial output"
        },
        {
          "type": "tool_execution_end",
          "toolCallId": "tool_1",
          "status": "completed",
          "output": "final output"
        }
      ],
      "expect": {
        "overlays": { "toolRunning": false },
        "toolCards": {
          "tool_1": { "status": "completed", "output": "final output" }
        }
      }
    },
    {
      "id": "failed-tool-stays-working-without-user-input",
      "events": [
        { "type": "agent_start", "runId": "run_1" },
        {
          "type": "tool_execution_start",
          "toolCallId": "tool_2",
          "name": "bash"
        },
        {
          "type": "tool_execution_end",
          "toolCallId": "tool_2",
          "status": "error",
          "exitCode": 1,
          "output": "command failed"
        }
      ],
      "expect": {
        "baseState": "working",
        "overlays": { "needsUserInput": false, "toolRunning": false },
        "toolCards": {
          "tool_2": {
            "status": "error",
            "isError": true,
            "output": "command failed"
          }
        },
        "sidebarPriority": "working"
      }
    },
    {
      "id": "queue-counts",
      "events": [
        { "type": "queue_update", "steeringCount": 1, "followUpCount": 2 }
      ],
      "expect": {
        "overlays": {
          "piQueuedSteeringCount": 1,
          "piQueuedFollowUpCount": 2
        }
      }
    },
    {
      "id": "compaction-lifecycle",
      "events": [{ "type": "compaction_start" }, { "type": "compaction_end" }],
      "expect": { "overlays": { "compacting": false } }
    },
    {
      "id": "auto-retry-lifecycle",
      "events": [
        { "type": "auto_retry_start", "attempt": 1, "maxAttempts": 2 },
        { "type": "auto_retry_end", "attempt": 1, "status": "recovered" }
      ],
      "expect": { "overlays": { "retrying": false } }
    },
    {
      "id": "extension-dialog-waiting-red-dot",
      "events": [
        {
          "type": "extension_ui_request",
          "requestId": "ext_1",
          "method": "confirm",
          "params": { "message": "Approve?" },
          "timeout": 5000
        }
      ],
      "expect": {
        "baseState": "waitingForInput",
        "overlays": { "needsUserInput": true },
        "sidebarPriority": "waitingForInput"
      }
    },
    {
      "id": "agent-end-clears-work-overlays",
      "events": [
        { "type": "agent_start", "runId": "run_1" },
        {
          "type": "message_update",
          "messageId": "msg_1",
          "role": "assistant",
          "content": "Done",
          "done": true
        },
        { "type": "agent_end", "runId": "run_1", "status": "completed" }
      ],
      "expect": {
        "baseState": "idle",
        "overlays": { "streaming": false, "toolRunning": false }
      }
    },
    {
      "id": "agent-end-does-not-clear-pending-dialog",
      "events": [
        { "type": "agent_start", "runId": "run_1" },
        {
          "type": "extension_ui_request",
          "requestId": "ext_1",
          "method": "input",
          "params": { "label": "Value" }
        },
        { "type": "agent_end", "runId": "run_1", "status": "completed" }
      ],
      "expect": {
        "baseState": "waitingForInput",
        "overlays": { "needsUserInput": true },
        "diagnosticsIncludes": "agent_end while extension UI request is pending"
      }
    },
    {
      "id": "error-agent-end-does-not-override-pending-dialog-attention",
      "events": [
        { "type": "agent_start", "runId": "run_1" },
        {
          "type": "extension_ui_request",
          "requestId": "ext_1",
          "method": "confirm"
        },
        { "type": "agent_end", "runId": "run_1", "status": "error" }
      ],
      "expect": {
        "baseState": "waitingForInput",
        "overlays": {
          "needsUserInput": true,
          "streaming": false,
          "toolRunning": false
        },
        "sidebarPriority": "waitingForInput",
        "pendingExtensionUiQueue": [
          { "requestId": "ext_1", "method": "confirm" }
        ],
        "diagnosticsIncludes": "agent_end while extension UI request is pending"
      }
    },
    {
      "id": "clearing-final-dialog-restores-terminal-provider-error",
      "events": [
        {
          "type": "extension_ui_request",
          "requestId": "ext_1",
          "method": "confirm"
        },
        {
          "type": "agent_end",
          "messages": [
            {
              "role": "assistant",
              "stopReason": "error",
              "errorMessage": "Provider quota exhausted."
            }
          ],
          "willRetry": false
        },
        {
          "type": "extension_ui_response_sent",
          "requestId": "ext_1"
        }
      ],
      "expect": {
        "baseState": "error",
        "overlays": { "needsUserInput": false },
        "sidebarPriority": "error",
        "pendingExtensionUiQueue": [],
        "diagnosticsIncludes": "Provider quota exhausted."
      }
    },
    {
      "id": "production-message-error-keeps-pending-dialog-actionable",
      "events": [
        { "type": "agent_start", "runId": "run_1" },
        {
          "type": "extension_ui_request",
          "requestId": "ext_1",
          "method": "confirm"
        },
        {
          "type": "message_update",
          "message": {
            "role": "assistant",
            "stopReason": "error",
            "errorMessage": "Provider quota exhausted."
          },
          "assistantMessageEvent": {
            "type": "error",
            "reason": "error",
            "error": {
              "role": "assistant",
              "stopReason": "error",
              "errorMessage": "Provider quota exhausted."
            }
          }
        }
      ],
      "expect": {
        "baseState": "waitingForInput",
        "terminalProviderErrorObserved": true,
        "overlays": { "streaming": false, "needsUserInput": true },
        "sidebarPriority": "waitingForInput",
        "pendingExtensionUiQueue": [
          { "requestId": "ext_1", "method": "confirm" }
        ],
        "diagnosticsIncludes": "Provider quota exhausted."
      }
    },
    {
      "id": "production-message-error-restores-terminal-failure-after-response",
      "events": [
        { "type": "agent_start", "runId": "run_1" },
        {
          "type": "extension_ui_request",
          "requestId": "ext_1",
          "method": "confirm"
        },
        {
          "type": "message_update",
          "message": {
            "role": "assistant",
            "stopReason": "error",
            "errorMessage": "Provider quota exhausted."
          },
          "assistantMessageEvent": {
            "type": "error",
            "reason": "error",
            "error": {
              "role": "assistant",
              "stopReason": "error",
              "errorMessage": "Provider quota exhausted."
            }
          }
        },
        {
          "type": "agent_end",
          "messages": [
            {
              "role": "assistant",
              "stopReason": "error",
              "errorMessage": "Provider quota exhausted."
            }
          ],
          "willRetry": false
        },
        {
          "type": "extension_ui_response_sent",
          "requestId": "ext_1"
        }
      ],
      "expect": {
        "baseState": "error",
        "terminalProviderErrorObserved": true,
        "overlays": { "streaming": false, "needsUserInput": false },
        "sidebarPriority": "error",
        "pendingExtensionUiQueue": [],
        "diagnosticsIncludes": "Provider quota exhausted."
      }
    },
    {
      "id": "retrying-agent-end-clears-transient-provider-error",
      "events": [
        { "type": "agent_start", "runId": "run_1" },
        {
          "type": "message_update",
          "message": {
            "role": "assistant",
            "stopReason": "error",
            "errorMessage": "Retryable provider failure."
          },
          "assistantMessageEvent": {
            "type": "error",
            "reason": "error",
            "error": {
              "role": "assistant",
              "stopReason": "error",
              "errorMessage": "Retryable provider failure."
            }
          }
        },
        { "type": "agent_end", "willRetry": true }
      ],
      "expect": {
        "baseState": "working",
        "terminalProviderErrorObserved": false,
        "overlays": {
          "streaming": false,
          "toolRunning": false,
          "retrying": true,
          "needsUserInput": false
        },
        "sidebarPriority": "retrying"
      }
    }
  ]
}
